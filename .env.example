# Ilavrita configuration (FR-040). Copy to .env for local development.
# Secrets never belong in source control.

# Network binding for the HTTP server.
ILAVRITA_HTTP_ADDR=127.0.0.1:8090

# Absolute, externally reachable base URL. Every published URL is built from it:
# Location, Bundle.entry.fullUrl and CapabilityStatement.implementation.url. Set
# it on any deployment behind a proxy, both because the proxy's own address is
# what clients resolve and because the scheme is taken from here rather than
# guessed from whether this process itself terminated TLS.
ILAVRITA_BASE_URL=http://127.0.0.1:8090

# Hosts whose own Host header may be published back, when no base URL is set.
# Comma-separated; the port is ignored. Unset, only loopback is published and
# any other Host answers 400: a Host is chosen by the client, so reflecting an
# unrecognised one would let a client point another at an attacker's origin.
# ILAVRITA_ALLOWED_HOSTS=fhir.example.org,records.example.org

# Directory holding the SQLite database and locally stored files.
ILAVRITA_DATA_DIR=./ilavrita_data

# Log verbosity: debug | info | warn | error.
# Resource bodies are never logged regardless of level (FR-034).
ILAVRITA_LOG_LEVEL=info

# File storage backend: local | s3 (FR-032).
ILAVRITA_FILE_STORAGE=local

# Expose PocketBase's own REST API and admin console at /api and /_ (FR-029).
# Off by default: they are not Ilavrita product surface, and they reach the
# image decoder affected by CVE-2023-36308. Turn on only for local development.
ILAVRITA_EXPOSE_POCKETBASE=false

# Serve every FHIR request as one fixed identity, with no credential checked.
# This is a development scaffold, not authentication: <project>:<kind>:<principal>,
# where kind is user, client_application or bot. Unset is the safe default and
# makes every FHIR route answer 401; a malformed value refuses to start.
# ILAVRITA_DEV_PRINCIPAL=
